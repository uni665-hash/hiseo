<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>장학·등록 백본 화면설계 — 클릭형 프로토타입</title>
<style>

  :root{
    --navy:#1c2b39; --navy2:#26384a;
    --accent:#c0392b;
    --blue:#2a78d6; --blue-dark:#1c5cab;
    --surface:#f4f5f7; --panel:#ffffff;
    --line:#dcdfe3; --text:#1f2328; --text2:#5b6470; --text3:#8b929c;
    --tab-active:#2a78d6;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:#eef0f2;font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;color:var(--text);}
  .doc{max-width:1280px;margin:0 auto;padding:28px 26px 70px;}

  /* ---- doc header ---- */
  .doc-head{margin-bottom:22px;}
  .doc-head .kicker{font-size:12px;font-weight:700;color:var(--blue);letter-spacing:.4px;text-transform:uppercase;}
  .doc-head h1{font-size:22px;margin:4px 0 6px;}
  .doc-head p{font-size:13px;color:var(--text2);margin:0;line-height:1.6;}
  .meta-row{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}
  .meta-chip{font-size:11.5px;background:#fff;border:1px solid var(--line);border-radius:7px;padding:5px 10px;color:var(--text2);}
  .meta-chip b{color:var(--text);}

  /* ---- mockup frame ---- */
  .frame{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:8px;
    overflow:hidden;
    box-shadow:0 2px 10px rgba(20,25,30,.08);
    margin-bottom:26px;
  }
  .frame-topbar{
    background:var(--navy);
    color:#fff;
    display:flex;align-items:center;
    padding:0 14px;
    height:38px;
    font-size:12.5px;
    gap:14px;
  }
  .frame-topbar .home{opacity:.6;}
  .frame-topbar .tabchip{
    background:var(--navy2);
    padding:6px 12px;height:100%;display:flex;align-items:center;gap:8px;
    border-right:1px solid #0f1a24;
  }
  .frame-topbar .tabchip .x{opacity:.5;font-size:11px;}

  .frame-crumb{
    background:#fff;
    border-bottom:2px solid var(--accent);
    padding:9px 16px;
    font-size:13px;
    font-weight:700;
    color:var(--text);
    display:flex;align-items:center;gap:8px;
  }
  .frame-crumb .id{font-weight:400;color:var(--text3);font-size:11.5px;}

  .filter-bar{
    background:#fafbfc;
    border-bottom:1px solid var(--line);
    padding:14px 16px;
    display:flex;flex-wrap:wrap;gap:10px 14px;align-items:flex-end;
  }
  .f-field{display:flex;flex-direction:column;gap:4px;position:relative;}
  .f-field label{font-size:10.5px;color:var(--text2);font-weight:700;}
  .f-field .ctrl{
    border:1px solid #c7cbd1;border-radius:5px;background:#fff;
    padding:6px 10px;font-size:12px;color:var(--text);min-width:118px;
    display:flex;align-items:center;justify-content:space-between;gap:6px;
  }
  .f-field .ctrl.wide{min-width:190px;}
  .f-field .ctrl .car{color:var(--text3);font-size:9px;}
  .callout{
    position:absolute;top:-9px;right:-9px;
    width:17px;height:17px;border-radius:50%;
    background:var(--accent);color:#fff;font-size:9.5px;font-weight:800;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 0 0 2px #fff;
  }
  .btnrow{display:flex;gap:8px;margin-left:auto;position:relative;}
  .btn{
    border-radius:5px;padding:7px 14px;font-size:12px;font-weight:700;
    border:1px solid var(--line);background:#fff;color:var(--text2);cursor:default;
  }
  .btn.primary{background:var(--blue);border-color:var(--blue);color:#fff;}
  .btn.ghost{background:#fff;}

  .tabs{display:flex;background:#fff;border-bottom:1px solid var(--line);padding:0 16px;gap:2px;position:relative;}
  .tab{
    padding:11px 18px;font-size:12.5px;font-weight:700;color:var(--text3);
    border-bottom:3px solid transparent;position:relative;
  }
  .tab.active{color:var(--tab-active);border-bottom-color:var(--tab-active);}
  .tab .n{
    display:inline-flex;align-items:center;justify-content:center;
    width:16px;height:16px;border-radius:50%;background:#e7edf5;color:var(--tab-active);
    font-size:9px;margin-right:5px;
  }
  .tab.active .n{background:var(--tab-active);color:#fff;}

  .grid-tools{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 16px;font-size:12px;color:var(--text2);
  }
  .grid-tools .count b{color:var(--accent);}
  .grid-actions{display:flex;gap:8px;}

  table.grid{width:100%;border-collapse:collapse;font-size:12px;}
  table.grid thead tr{border-top:2px solid var(--accent);border-bottom:1px solid var(--line);background:#f7f8f9;}
  table.grid th{
    padding:9px 8px;text-align:center;font-weight:700;color:var(--text2);
    border-right:1px solid #eceef0;white-space:nowrap;position:relative;
  }
  table.grid th:last-child{border-right:none;}
  table.grid td{padding:8px;text-align:center;border-bottom:1px solid #f0f1f3;border-right:1px solid #f5f6f7;color:var(--text);white-space:nowrap;}
  table.grid td:last-child{border-right:none;}
  table.grid tbody tr:hover{background:#f5f9fe;}
  .status{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10.5px;font-weight:700;}
  .status.ok{background:#e6f4ea;color:#1e7b34;}
  .status.wait{background:#fdf0e3;color:#b06a12;}
  .status.no{background:#fbe9e9;color:#c0392b;}
  .status.mid{background:#eaf1fb;color:#2a78d6;}

  .frame-foot{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 16px;border-top:1px solid var(--line);background:#fafbfc;font-size:11px;color:var(--text3);
  }

  /* preview strip for other tabs */
  .other-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:26px;}
  .other-tab-card{background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden;}
  .other-tab-card .oh{padding:9px 12px;font-size:12px;font-weight:700;background:#f7f8f9;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:6px;}
  .other-tab-card .oh .n{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:#dfe4ea;color:#5b6470;font-size:8.5px;}
  .other-tab-card table{width:100%;border-collapse:collapse;font-size:10.5px;}
  .other-tab-card th{padding:6px 5px;background:#fcfcfd;color:var(--text3);border-bottom:1px solid var(--line);font-weight:700;}
  .other-tab-card td{padding:6px 5px;border-bottom:1px solid #f4f5f6;color:var(--text2);text-align:center;}

  /* spec table */
  .spec-title{font-size:15px;font-weight:800;margin:0 0 4px;display:flex;align-items:center;gap:8px;}
  .spec-title .badge{background:var(--accent);color:#fff;font-size:10px;padding:3px 9px;border-radius:999px;}
  .spec-sub{font-size:12px;color:var(--text2);margin:0 0 14px;}
  table.spec{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden;font-size:12px;margin-bottom:26px;}
  table.spec th{background:var(--navy);color:#fff;padding:9px 10px;text-align:left;font-size:11.5px;}
  table.spec td{padding:9px 10px;border-bottom:1px solid #eef0f2;vertical-align:top;line-height:1.5;}
  table.spec tr:last-child td{border-bottom:none;}
  table.spec td.tag{white-space:nowrap;}
  .tagnum{
    display:inline-flex;align-items:center;justify-content:center;
    width:20px;height:20px;border-radius:5px;background:var(--accent);color:#fff;font-weight:800;font-size:11px;
  }
  table.spec td.name{font-weight:700;white-space:nowrap;}
  table.spec td.type{color:var(--text2);white-space:nowrap;font-size:11px;}
  .src{font-size:10.5px;color:var(--text3);}

  .section-h{font-size:16px;font-weight:800;margin:30px 0 4px;padding-top:16px;border-top:1px solid var(--line);}
  .section-sub{font-size:12.5px;color:var(--text2);margin:0 0 14px;line-height:1.6;}
  .flow-note{background:#eaf1fb;border:1px solid #c7dbf5;border-radius:8px;padding:12px 14px;font-size:12px;color:#1c5cab;margin-bottom:20px;line-height:1.7;}
  .flow-note b{color:#123f7a;}


  .grp thead tr.grp-row th{border-top:2px solid var(--accent);background:#fbfbfb;font-size:10.5px;color:var(--text2);}
  .grp thead tr.sub-row th{border-top:none;}
  th.g-before{background:#fdf3f0;color:#a83e2c;}
  th.g-after{background:#eef6ef;color:#1e7b34;}
  td.g-before{background:#fffaf8;}
  td.g-after{background:#f8fcf9;}
  .diff-up{color:#c0392b;font-weight:700;}
  .diff-none{color:#b7bcc2;}
  .boundary-strip{display:flex;align-items:center;gap:10px;margin:18px 0;}
  .boundary-strip .bl{flex:1;height:2px;background:repeating-linear-gradient(90deg,#4a3aa7 0 6px,transparent 6px 12px);}
  .boundary-strip .lbl{font-size:11.5px;font-weight:800;color:#4a3aa7;background:#eeecfa;padding:6px 12px;border-radius:999px;white-space:nowrap;}
  .popup-card{background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 20px rgba(20,25,30,.12);padding:14px;max-width:420px;margin-bottom:26px;}
  .popup-card .ph{font-size:12.5px;font-weight:800;margin-bottom:8px;display:flex;justify-content:space-between;}
  .popup-card .ph .x{color:var(--text3);font-weight:400;}
  .timeline{display:flex;flex-direction:column;gap:8px;}
  .tl-item{display:flex;gap:8px;font-size:11.5px;}
  .tl-item .dot{width:8px;height:8px;border-radius:50%;background:var(--blue);margin-top:4px;flex:0 0 auto;}
  .tl-item .tlbody b{display:block;color:var(--text);}
  .tl-item .tlbody span{color:var(--text3);font-size:10.5px;}
  .subform{background:#fafbfc;border:1px solid var(--line);border-radius:8px;padding:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
  .subform .sf-field label{display:block;font-size:10.5px;color:var(--text2);font-weight:700;margin-bottom:4px;}
  .subform .sf-field .val{border:1px solid #c7cbd1;border-radius:5px;background:#fff;padding:7px 10px;font-size:12px;}
  .scope-strip{display:flex;gap:8px;padding:9px 16px;background:#fbfbfd;border-bottom:1px solid var(--line);align-items:center;flex-wrap:wrap;}
  .scope-label{font-size:10px;color:var(--text3);font-weight:700;margin-right:2px;}
  .scope-pill{font-size:10.5px;font-weight:700;padding:4px 10px;border-radius:999px;display:inline-flex;align-items:center;gap:5px;}
  .scope-pill.biz-sch{background:#e7f0fb;color:#1c5cab;}
  .scope-pill.biz-reg{background:#fdece3;color:#a83e2c;}
  .scope-pill.course{background:#eeecfa;color:#4a3aa7;}
  .scope-pill .lock{opacity:.65;font-size:9.5px;font-weight:600;}

  .kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px;}
  .kpi-tile{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 16px;position:relative;}
  .kpi-tile .kl{font-size:11px;color:var(--text3);font-weight:700;margin-bottom:6px;}
  .kpi-tile .kv{font-size:21px;font-weight:800;color:var(--text);}
  .kpi-tile .kv span{font-size:12px;font-weight:700;color:var(--text3);margin-left:2px;}
  .kpi-tile.hl .kv{color:var(--blue-dark);}
  .badge-auto{background:#eef6ef;color:#1e7b34;font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;}
  .stackwrap{margin-bottom:8px;}
  .stackwrap .sw-label{font-size:11px;font-weight:700;color:var(--text2);margin-bottom:5px;display:flex;justify-content:space-between;}
  .stackbar{display:flex;height:20px;border-radius:5px;overflow:hidden;border:1px solid var(--line);}
  .stackbar .seg{display:flex;align-items:center;justify-content:center;font-size:9.5px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;}
  .legend{display:flex;gap:14px;flex-wrap:wrap;margin:8px 0 20px;}
  .legend .lg{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--text2);}
  .legend .dot{width:9px;height:9px;border-radius:2px;}
  .cert-box{background:#fff;border:1px solid var(--line);border-radius:8px;padding:22px 26px;max-width:480px;}
  .cert-box .ctitle{text-align:center;font-size:15px;font-weight:800;letter-spacing:2px;margin-bottom:16px;}
  .cert-box .cmeta{font-size:11.5px;color:var(--text2);line-height:1.9;margin-bottom:12px;}
  .cert-box .cmeta b{color:var(--text);}
  .cert-box table{width:100%;border-collapse:collapse;font-size:11px;margin-bottom:12px;}
  .cert-box th{background:#f7f8f9;border:1px solid var(--line);padding:6px 7px;color:var(--text2);}
  .cert-box td{border:1px solid var(--line);padding:6px 7px;text-align:center;}
  .cert-box .csum{text-align:right;font-size:12px;font-weight:700;margin-bottom:16px;}
  .cert-box .cfoot{text-align:center;font-size:11.5px;line-height:2;position:relative;}
  .cert-box .stamp{
    position:absolute;right:18px;top:-6px;width:52px;height:52px;border:2px solid #c0392b;border-radius:50%;
    color:#c0392b;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;
    transform:rotate(-8deg);opacity:.75;text-align:center;line-height:1.3;
  }

  .badge-core{background:#fdece3;color:#a83e2c;font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;}
  .reg-form{background:#fafbfc;border:1px solid var(--line);border-radius:8px;padding:16px 18px;margin-bottom:8px;}
  .reg-form .rf-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px;}
  .reg-form .rf-field{display:flex;flex-direction:column;gap:4px;position:relative;}
  .reg-form .rf-field.full{grid-column:1 / -1;}
  .reg-form .rf-field label{font-size:10.5px;color:var(--text2);font-weight:700;}
  .reg-form .rf-field .val{border:1px solid #c7cbd1;border-radius:5px;background:#fff;padding:7px 10px;font-size:12px;color:var(--text);min-height:14px;}
  .crit-list{display:flex;flex-direction:column;gap:8px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:12px 14px;}
  .crit-row{display:grid;grid-template-columns:26px 1fr 120px 40px;gap:10px;align-items:center;font-size:12px;padding:6px 0;border-bottom:1px solid #f0f1f3;}
  .crit-row:last-child{border-bottom:none;}
  .crit-row .cchk{width:16px;height:16px;border:1.5px solid #c7cbd1;border-radius:4px;}
  .crit-row .ctype{font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:999px;text-align:center;}
  .crit-row .ctype.auto{background:#eaf1fb;color:#2a78d6;}
  .crit-row .ctype.manual{background:#fdf0e3;color:#b06a12;}
  .crit-row .cpt{font-weight:800;color:var(--text2);text-align:right;}

  .dday-chip{font-size:10.5px;font-weight:800;padding:3px 9px;border-radius:999px;display:inline-block;}
  .dday-chip.ok{background:#eaf1fb;color:#2a78d6;}
  .dday-chip.soon{background:#fdf0e3;color:#b06a12;}
  .dday-chip.over{background:#fbe9e9;color:#c0392b;}
  .prog-track{background:#eceff2;border-radius:999px;height:8px;width:100%;overflow:hidden;}
  .prog-fill{background:#2a78d6;height:100%;border-radius:999px;}
  .ach-item{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f0f1f3;font-size:11.5px;}
  .ach-item:last-child{border-bottom:none;}
  .ach-item .at{font-weight:700;color:var(--text);}
  .ach-item .as{color:var(--text3);font-size:10.5px;}
  .dday-chip.warn{background:#fdf0e3;color:#b06a12;}
  .prog-fill.danger{background:#c0392b;}
  .month-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;}
  .month-cell{border:1px solid var(--line);border-radius:6px;padding:7px 6px;text-align:center;background:#fff;}
  .month-cell .m{font-size:10px;color:var(--text3);font-weight:700;}
  .month-cell .s{font-size:10.5px;font-weight:800;margin-top:3px;}
  .month-cell.done{background:#f2f9f4;border-color:#c8e6cf;}
  .month-cell.done .s{color:#1e7b34;}
  .month-cell.pending{background:#fbfcfd;}
  .month-cell.pending .s{color:#8b929c;}
  .month-cell.risk{background:#fdf0e3;border-color:#f3d9b1;}
  .month-cell.risk .s{color:#b06a12;}

  .scope-pill.biz-ms{background:#eef6ef;color:#1e7b34;}
  .ms-topbar{background:#0f3d63;color:#fff;display:flex;align-items:center;padding:0 16px;height:42px;font-size:12.5px;gap:14px;}
  .ms-topbar .brand{font-weight:800;letter-spacing:.3px;}
  .ms-topbar .brand span{color:#7fc4ff;}
  .ms-topbar .tabchip{background:#154d7a;padding:7px 12px;height:100%;display:flex;align-items:center;gap:8px;border-right:1px solid #0a2e4d;}
  .ms-topbar .tabchip .x{opacity:.5;font-size:11px;}
  .student-card{display:flex;gap:22px;align-items:center;background:#fbfcfe;border-bottom:1px solid var(--line);padding:14px 16px;flex-wrap:wrap;}
  .student-card .avatar{width:44px;height:44px;border-radius:50%;background:#dce8f7;color:#1c5cab;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex:0 0 auto;}
  .student-card .sinfo{font-size:12.5px;color:var(--text2);line-height:1.6;}
  .student-card .sinfo b{color:var(--text);font-size:13.5px;}
  .student-card .stag{font-size:10px;color:var(--text3);background:#fff;border:1px solid var(--line);border-radius:999px;padding:3px 9px;margin-left:6px;}
  .schol-list{display:flex;flex-direction:column;gap:10px;margin-bottom:8px;}
  .schol-card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;position:relative;}
  .schol-card .sc-l{display:flex;flex-direction:column;gap:5px;}
  .schol-card .sc-name{font-size:13.5px;font-weight:800;color:var(--text);}
  .schol-card .sc-meta{font-size:11px;color:var(--text3);}
  .schol-card .sc-dday{font-size:10.5px;font-weight:800;color:#c0392b;background:#fbe9e9;padding:3px 9px;border-radius:999px;}
  .schol-card .sc-dday.soon{color:#b06a12;background:#fdf0e3;}
  .schol-card.disabled{opacity:.55;}
  .apply-form{background:#fafbfc;border:1px solid var(--line);border-radius:8px;padding:18px 20px;margin-bottom:22px;}
  .apply-form .af-row{display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #eef0f2;font-size:12.5px;}
  .apply-form .af-row:last-of-type{border-bottom:none;}
  .apply-form .af-label{color:var(--text2);font-weight:700;}
  .apply-form .af-val{color:var(--text);}
  .apply-form .af-val.locked{color:var(--text3);}
  .upload-zone{border:1.5px dashed #b9c2cc;border-radius:8px;padding:18px;text-align:center;font-size:11.5px;color:var(--text3);background:#fff;}
  .upload-zone b{color:var(--blue);}
  .agree-row{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text2);margin-top:10px;}
  .agree-row input{transform:translateY(1px);}
  .agree-row a{color:var(--blue);font-weight:700;}
  .my-apps{width:100%;border-collapse:collapse;font-size:12px;}
  .my-apps th{padding:8px;background:#f7f8f9;border-bottom:1px solid var(--line);color:var(--text2);font-weight:700;text-align:center;}
  .my-apps td{padding:9px 8px;border-bottom:1px solid #f0f1f3;text-align:center;color:var(--text);}

  .badge-req{background:#eaf1fb;color:#1c5cab;font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;}
  .wide-grid-wrap{overflow-x:auto;border-bottom:1px solid var(--line);}
  .wide-grid-wrap table.grid{min-width:2350px;}
  .scroll-hint{font-size:10.5px;color:var(--text3);padding:6px 16px;background:#fbfbfd;border-bottom:1px solid var(--line);}
  .grade-table{width:100%;border-collapse:collapse;font-size:11px;margin:8px 0 10px;}
  .grade-table th{padding:6px 5px;background:#f7f8f9;color:var(--text3);border-bottom:1px solid var(--line);font-weight:700;text-align:center;}
  .grade-table td{padding:6px 5px;border-bottom:1px solid #f4f5f6;color:var(--text2);text-align:center;}
  .flag-chip{font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:999px;display:inline-flex;align-items:center;gap:3px;white-space:nowrap;}
  .flag-chip.exchange{background:#eaf1fb;color:#1c5cab;}
